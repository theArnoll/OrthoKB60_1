#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h> // for OUT_TOG

#define UMLAUT_MACROS(name, low_seq, up_seq) \
    name##_low:name##_low { \
        compatible = "zmk,behavior-macro";\
        #binding-cells = <0>;\
        wait-ms = <15>; tap-ms = <15>;\
        bindings = <&macro_tap low_seq>;\
    }; \
    name##_up: name##_up { \
        compatible = "zmk,behavior-macro";\
        #binding-cells = <0>;\
        wait-ms = <15>; tap-ms = <15>;\
        bindings = <&macro_tap up_seq>;\
    };

#define UMLAUT_MOD_MORPH(name) \
    name: name { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&name##_low>, <&name##_up>; mods = <(MOD_LSFT|MOD_RSFT)>; };

#define UMLAUT_COMBO(name, k1, k2, bind, lyr) \
    combo_##name { \
        timeout-ms = <40>;\
        key-positions = <k1 k2>;\
        bindings = <bind>;\
        layers = <lyr>;\
    };

&kscan0 {
    debounce-press-ms = <1>;
    debounce-release-ms = <1>;
};

// * Keymap from Line 211
//  or Ctrl + F `zmk,keymap`

/ {
    behaviors {
        UMLAUT_MOD_MORPH(umlaut_a_compose)       UMLAUT_MOD_MORPH(umlaut_o_compose)
        UMLAUT_MOD_MORPH(umlaut_u_compose)       UMLAUT_MOD_MORPH(eszett_compose)
        UMLAUT_MOD_MORPH(umlaut_a_macOS)         UMLAUT_MOD_MORPH(umlaut_o_macOS)
        UMLAUT_MOD_MORPH(umlaut_u_macOS)         UMLAUT_MOD_MORPH(eszett_macOS)

        UMLAUT_MOD_MORPH(umlaut_a_compose_HWDv)  UMLAUT_MOD_MORPH(umlaut_o_compose_HWDv)
        UMLAUT_MOD_MORPH(umlaut_u_compose_HWDv)  UMLAUT_MOD_MORPH(eszett_compose_HWDv)
        UMLAUT_MOD_MORPH(umlaut_a_macOS_HWDv)    UMLAUT_MOD_MORPH(umlaut_o_macOS_HWDv)
        UMLAUT_MOD_MORPH(umlaut_u_macOS_HWDv)    UMLAUT_MOD_MORPH(eszett_macOS_HWDv)

        layoutShift_tapShift: layoutShift_tapShift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            //     long hold  short tap
            bindings = <&kp>, <&layoutShift_tShift>;
        };

        layoutShift_tapCaps: layoutShift_tapCaps {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&layoutShift_tCaps>;
        };

        layoutShift_Super_Space: layoutShift_Super_Space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&layoutShift_Supr_Spc>;
        };

        layoutShift_Ctrl_Space: layoutShift_Ctrl_Space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&layoutShift_Ctrl_Spc>;
        };
    };  // Generated by Gemini on Google AI Studio

    macros {

        layoutShift_tShift: layoutShift_tShift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &tog 2 &kp LSHFT> ;
        };

        layoutShift_tCaps: layoutShift_tCaps {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &tog 2 &kp CAPSLOCK> ;
        };

        layoutShift_Supr_Spc: layoutShift_Supr_Spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &tog 2 &macro_press &kp LGUI &macro_tap &kp SPACE &macro_release &kp LGUI> ;
        };

        layoutShift_Ctrl_Spc: layoutShift_Ctrl_Spc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &tog 2 &macro_press &kp LCTRL &macro_tap &kp SPACE &macro_release &kp LCTRL> ;
        };

        natuIM_zhQt: natuIM_zhQt {  // A paid input method for Chinese. 自然輸入法引號預設固定位置，輸入後自動把游標放到引號中間
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LCTRL &macro_tap &kp N7 &macro_release &kp LCTRL
                        &macro_tap &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp N3 &kp N4 &kp ESC &kp ENTER &kp LEFT> ;
        };

        // Assisted by Gemini on Google AI Studio start

        // Normal Compose
        UMLAUT_MACROS(umlaut_a_compose, &kp K_APP &kp LS(Q) &kp A,    &kp K_APP &kp LS(Q) &kp LS(A))
        UMLAUT_MACROS(umlaut_o_compose, &kp K_APP &kp LS(Q) &kp S,    &kp K_APP &kp LS(Q) &kp LS(S))
        UMLAUT_MACROS(umlaut_u_compose, &kp K_APP &kp LS(Q) &kp F,    &kp K_APP &kp LS(Q) &kp LS(F))
        UMLAUT_MACROS(eszett_compose,   &kp K_APP &kp SEMI  &kp SEMI, &kp K_APP &kp LS(SEMI) &kp LS(SEMI))

        // Normal macOS
        UMLAUT_MACROS(umlaut_a_macOS,   &kp LA(F) &kp A,              &kp LA(F) &kp LS(A))
        UMLAUT_MACROS(umlaut_o_macOS,   &kp LA(F) &kp S,              &kp LA(F) &kp LS(S))
        UMLAUT_MACROS(umlaut_u_macOS,   &kp LA(F) &kp F,              &kp LA(F) &kp LS(F))
        UMLAUT_MACROS(eszett_macOS,     &kp LA(SEMI),                 &kp LS(SEMI) &kp LS(SEMI))

        // Hardware Dvorak Compose
        UMLAUT_MACROS(umlaut_a_compose_HWDv, &kp K_APP &kp DQT &kp A, &kp K_APP &kp DQT &kp LS(A))
        UMLAUT_MACROS(umlaut_o_compose_HWDv, &kp K_APP &kp DQT &kp O, &kp K_APP &kp DQT &kp LS(O))
        UMLAUT_MACROS(umlaut_u_compose_HWDv, &kp K_APP &kp DQT &kp U, &kp K_APP &kp DQT &kp LS(U))
        UMLAUT_MACROS(eszett_compose_HWDv,   &kp K_APP &kp S   &kp S, &kp K_APP &kp LS(S) &kp LS(S))

        // Hardware Dvorak macOS
        UMLAUT_MACROS(umlaut_a_macOS_HWDv,   &kp LA(U) &kp A,         &kp LA(U) &kp LS(A))
        UMLAUT_MACROS(umlaut_o_macOS_HWDv,   &kp LA(U) &kp O,         &kp LA(U) &kp LS(O))
        UMLAUT_MACROS(umlaut_u_macOS_HWDv,   &kp LA(U) &kp U,         &kp LA(U) &kp LS(U))
        UMLAUT_MACROS(eszett_macOS_HWDv,     &kp LA(S),               &kp LS(S) &kp LS(S))

        // Assisted by Gemini on Google AI Studio end

        umlaut_a_Windows: umlaut_a_Windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT
                        &macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N8
                        &macro_release &kp RALT>;
        };

        umlaut_o_Windows: umlaut_o_Windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT
                        &macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N4 &kp KP_N6
                        &macro_release &kp RALT>;
        };

        umlaut_u_Windows: umlaut_u_Windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT
                        &macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N5 &kp KP_N2
                        &macro_release &kp RALT>;
        };

        eszett_Windows: eszett_Windows {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp RALT
                        &macro_tap &kp KP_N0 &kp KP_N2 &kp KP_N2 &kp KP_N3
                        &macro_release &kp RALT>;
        };

    };

    combos {
        compatible = "zmk,combos";

        // Normal Compose
        UMLAUT_COMBO(ae_Normal, 29, 31, &umlaut_a_compose, 0)
        UMLAUT_COMBO(oe_Normal, 30, 31, &umlaut_o_compose, 0)
        UMLAUT_COMBO(ue_Normal, 32, 31, &umlaut_u_compose, 0)
        UMLAUT_COMBO(sz_Normal, 31, 38, &eszett_compose,   0)

        // Normal macOS
        UMLAUT_COMBO(ae_Normal_macOS, 29, 31, &umlaut_a_macOS,   1)
        UMLAUT_COMBO(oe_Normal_macOS, 30, 31, &umlaut_o_macOS,   1)
        UMLAUT_COMBO(ue_Normal_macOS, 32, 31, &umlaut_u_macOS,   1)
        UMLAUT_COMBO(sz_Normal_macOS, 31, 38, &eszett_macOS,     1)

        // Hardware Dvorak Compose
        UMLAUT_COMBO(ae_HWDv, 29, 31, &umlaut_a_compose_HWDv, 2)
        UMLAUT_COMBO(oe_HWDv, 30, 31, &umlaut_o_compose_HWDv, 2)
        UMLAUT_COMBO(ue_HWDv, 32, 31, &umlaut_u_compose_HWDv, 2)
        UMLAUT_COMBO(sz_HWDv, 31, 38, &eszett_compose_HWDv,   2)

        /*
        // Hardware Dvorak macOS
        UMLAUT_COMBO(ae_ln, 29, 31, &umlaut_a_macOS_HWDv, 2)
        UMLAUT_COMBO(oe_ln, 30, 31, &umlaut_o_macOS_HWDv, 2)
        UMLAUT_COMBO(ue_ln, 32, 31, &umlaut_u_macOS_HWDv, 2)
        UMLAUT_COMBO(sz_ln, 31, 38, &eszett_macOS_HWDv,   2)
        */
        
        // Combos generated by Gemini on Google AI Studio until here

        backspaceCombo { \
            timeout-ms = <40>;\
            key-positions = <12 13>;\
            bindings = <&kp BACKSPACE>;\
            layers = < 0 1 2 3 4 5 6 >;\
        };
        
        enterCombo { \
            timeout-ms = <40>;\
            key-positions = <40 41>;\
            bindings = <&kp ENTER>;\
            layers = < 0 1 2 3 4 5 6 >;\
        };
    };  

    keymap {
        compatible = "zmk,keymap";

        Default_Layer { // Layer 0
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I     &kp O   &kp P    &kp LBKT  &kp RBKT  &kp BSLH
                &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT   &kp END   &kp ENTER
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp HOME  &kp UP    &layoutShift_tapShift RSHIFT 0
                &kp LCTRL &kp LGUI &kp LALT                &kp SPACE                 &kp F13 &mo 3    &kp LEFT  &kp DOWN   &kp RIGHT
            >;
        };

        macOS_Layer { // Layer 1 | macOS Layer
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I     &kp O   &kp P    &kp LBKT  &kp RBKT  &kp BSLH
                &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT   &kp END   &kp ENTER
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &kp HOME  &kp UP    &layoutShift_tapCaps RSHIFT 0
                &kp LCTRL &kp LALT &kp LGUI                &kp SPACE                 &kp F13 &mo 4    &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        Hardware_Dvorak { // Layer 2 | Hardware Dvorak
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8  &kp N9  &kp N0 &kp LBKT  &kp RBKT  &kp BSPC
                &kp TAB    &kp SQT &kp COMMA &kp DOT &kp P &kp Y &kp F &kp G &kp C &kp R   &kp L  &kp FSLH  &kp EQUAL &kp BSLH
                &kp CAPS   &kp A   &kp O  &kp E  &kp U  &kp I  &kp D  &kp H  &kp T &kp N   &kp S  &kp MINUS &kp END   &kp ENTER 
                &kp LSHFT &kp SEMI &kp Q  &kp J  &kp K  &kp X  &kp B  &kp M  &kp W &kp V   &kp Z  &kp HOME  &kp UP    &trans
                &trans    &trans   &trans                  &kp SPACE               &kp F13 &trans &kp LEFT  &kp DOWN  &kp RIGHT
            >;
        };

        fnLayer { // Layer 3 | fn Layer (imcomplete)
            bindings = <
                &kp ESC    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6       &kp F7 &kp F8 &kp F9   &kp F10 &kp C_VOL_UP &kp C_VOL_DN &kp DEL
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_TOG &trans &trans &trans   &trans  &trans       &trans       &kp C_PLAY_PAUSE
                &trans     &trans       &trans       &natuIM_zhQt &tog 6       &trans       &trans       &trans &trans &trans   &trans  &trans       &kp PG_DN    &trans
                &trans     &trans       &trans       &trans       &trans       &trans       &trans       &trans &trans &trans   &trans  &kp PAGE_UP  &trans       &tog 1
                &trans     &trans       &trans                                 &trans                                  &kp RALT &trans  &mo 5        &kp GLOBE    &kp RALT
            >;  
        };

        macOS_fnLayer { // Layer 4 | Mac fn Layer (imcomplete)  
            bindings = <
                &kp ESC    &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6 &kp F7 &kp F8 &kp F9    &kp F10 &kp C_VOL_UP &kp C_VOL_DN &kp DEL
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &trans &trans &trans    &trans  &trans       &trans       &kp C_PLAY_PAUSE
                &out OUT_TOG &trans     &trans       &natuIM_zhQt &tog 6       &trans       &trans &trans &trans &trans    &trans  &trans       &kp PG_DN    &trans
                &trans     &trans       &trans       &trans       &trans       &trans       &trans &trans &trans &trans    &trans  &kp PAGE_UP  &trans       &tog 1
                &trans     &trans       &trans                                 &trans                            &kp RALT  &trans  &mo 5        &kp GLOBE    &kp RGUI
            >;
        };

        fn2Layer { // Layer 5 | fn2 Layer (imcomplete)
            bindings = <
                &studio_unlock &kp F14   &kp F15    &kp F16     &kp F17    &kp F18 &kp F19 &kp F20 &kp F21 &kp F22  &kp F23 &kp F11 &kp F12   &trans
                &trans         &trans    &trans     &trans      &trans     &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans    &trans
                &kp LS(HOME)   &kp LC(A) &kp LC(S)  &kp LS(END) &trans     &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans    &trans
                &trans         &kp LC(Z) &kp LC(X)  &kp LC(C)   &kp LC(V)  &trans  &trans  &trans  &trans  &trans   &trans  &trans  &trans    &trans
                &trans         &trans    &kp RALT                        &trans                              &kp RALT &trans  &trans  &kp GLOBE &trans
            >;
        };

        bluetooth_layer {
            bindings = <
                &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2
                &bt BT_SEL 3   &bt BT_SEL 4 &bt BT_CLR 
                &bt BT_CLR_ALL &out OUT_BLE &out OUT_USB
                &to 1          &to 0        &to 6
            >;
        };

        someLayer {
            bindings = <
                &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2
                &bt BT_SEL 3   &bt BT_SEL 4 &bt BT_CLR 
                &bt BT_CLR_ALL &out OUT_BLE &out OUT_USB
                &to 1          &to 0        &to 6
            >;
        };
    };
};