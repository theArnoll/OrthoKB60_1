#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h> // for OUT_TOG

&kscan0 {
    debounce-press-ms = <3>;
    debounce-release-ms = <3>;
};

/ {
    macros {  // https://v0-3-branch.zmk.dev/docs/keymaps/behaviors/macros
        zed_em_kay: zed_em_kay {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &kp LSHFT>
                , <&macro_tap &kp Z &kp M &kp K>
                , <&macro_release &kp LSHFT> ;
        };

        layoutShift-tapShift: layoutShift-tapShift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &tog 1 &kp LSHFT> ;
        };

        layoutShift-Supr-Space: layoutShift-Supr-Space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &tog 1 &macro_press &kp LGUI &macro_tap &kp SPACE &macro_release &kp LGUI> ;
        };

        layoutShift-Ctrl-Space: layoutShift-Ctrl-Space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &tog 1 &macro_press &kp LCTRL &macro_tap &kp SPACE &macro_release &kp LCTRL> ;
        };

        swLyr: swLyr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &to 1 &kp N0> ;
        };
    };

    keymap {
        compatible = "zmk,keymap";


        default_layer { // Layer 0
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LBKT  &kp RBKT  &kp BSLASH
                &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp QUOTE &kp END &kp ENTER
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp SLASH &kp HOME &kp UP &layoutShift-tapShift
                &kp LCTRL &kp LGUI &kp LALT                &kp SPACE                &kp F13 &mo 3 &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        default_layer { // Layer 1 | Hardware Dvorak
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp LBKT  &kp RBKT &kp BSPC
                &kp TAB   &kp QUOTE &kp COMMA &kp DOT &kp P &kp Y &kp F &kp G &kp C &kp R &kp L &kp SLASH &kp EQUAL &kp BSLASH
                &kp CAPS  &kp A  &kp O  &kp E  &kp U  &kp I  &kp D  &kp H  &kp T  &kp N  &kp S &kp MINUS &kp END &kp ENTER
                &kp LSHFT &kp SEMI &kp Q  &kp J  &kp K  &kp X  &kp B  &kp M &kp W  &kp V &kp Z &kp HOME &kp UP &layoutShift-tapShift
                &kp LCTRL &kp LGUI &kp LALT                &kp SPACE                &kp F13 &mo 3 &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        default_layer { // Layer 2 | macOS Layer
            bindings = <
                &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N10  &kp MINUS &kp EQUAL &kp BSPC
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P    &kp LBKT  &kp RBKT  &kp BSLASH
                &kp CAPS  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp QUOTE &kp END   &kp ENTER
                &kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp SLASH &kp HOME &kp UP &layoutShift-tapShift
                &kp LCTRL &kp LALT &kp LGUI                &kp SPACE                &kp F13 &mo 4 &kp LEFT &kp DOWN &kp RIGHT
            >;
        };

        default_layer { // Layer 3 | fn Layer (imcomplete)
            bindings = <
                &kp ESC &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &kp C_VOL_UP &kp C_VOL_DN &kp DEL
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans  &trans  &trans  &trans  &trans  &trans &trans &C_PLAY_PAUSE
                &trans &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans &kp PAGE_DOWN &trans
                &trans &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp PAGE_UP &trans &to 2
                &trans &trans  &kp RALT                       &trans                         &RALT &trans &mo 5 &kp GLOBE &kp RALT
            >;
        };
        default_layer { // Layer 4 | Mac fn Layer (imcomplete)
            bindings = <
                &kp ESC &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10 &kp C_VOL_UP &kp C_VOL_DN &kp DEL
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans  &trans  &trans  &trans  &trans  &trans &trans &C_PLAY_PAUSE
                &trans &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans &trans &trans
                &trans &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans &trans &to 0
                &trans &trans  &kp RALT                  &trans                         &RALT &trans &mo 5 &kp GLOBE &kp RGUI
            >;
        };
        default_layer { // Layer 5 | fn2 Layer (imcomplete)
            bindings = <
                &studio_unlock &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans         &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans         &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans         &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &to 2
                &trans         &trans &trans                 &trans                &RALT &trans &kp GLOBE &kp DOWN &kp RALT
            >;
        };

        bluetooth_layer { // Layer 3
            bindings = <
                &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2
                &bt BT_SEL 3   &bt BT_SEL 4 &bt BT_CLR 
                &bt BT_CLR_ALL &out OUT_BLE &out OUT_USB
                &to 1          &to 0        &to 6
            >;
        };

        switch_layer {
            bindings = <
                &to 0  &to 1  &to 2
                &to 3  &to 4  &to 5
                &zed_em_kay  &test_macro &swLyr
                &out OUT_TOG &to 1       &studio_unlock
            >;
        };
    };
};